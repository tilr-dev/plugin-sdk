{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommitTypeAll(chore)"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "GitHub Actions: one PR, pinned to commit SHAs",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "The check toolchain (Biome, ESLint, commitlint, jscpd, knip, lefthook): one PR",
      "matchPackageNames": [
        "@biomejs/biome",
        "eslint",
        "@eslint/js",
        "typescript-eslint",
        "@eslint-community/eslint-plugin-eslint-comments",
        "@commitlint/**",
        "conventional-changelog-conventionalcommits",
        "jscpd",
        "knip",
        "lefthook"
      ],
      "groupName": "check toolchain"
    }
  ]
}
