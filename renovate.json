{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommitTypeAll(chore)"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "GitHub Actions: one PR, pinned to commit SHAs",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "The check toolchain (Biome, commitlint, jscpd, knip, lefthook): one PR",
      "matchPackageNames": [
        "@biomejs/biome",
        "@commitlint/**",
        "conventional-changelog-conventionalcommits",
        "jscpd",
        "knip",
        "lefthook"
      ],
      "groupName": "check toolchain"
    },
    {
      "description": "TypeScript and oxlint move together: oxlint-tsgolint is built on one TypeScript release",
      "matchPackageNames": ["typescript", "oxlint", "oxlint-tsgolint"],
      "groupName": "typescript and oxlint"
    }
  ]
}
