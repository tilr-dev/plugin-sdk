{
  "name": "@tilr-dev/plugin",
  "version": "0.2.1",
  "tilrApi": "0.1.14",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "description": "The kit for writing Tilr plugins in their own repos: the plugin API's types, the shared build and CLI (tilr-plugin), the e2e harness with the built core page, shared tsconfig, oxlint and Playwright config, and the repo standard's checks (tilr-plugin verify) with their presets (Biome, lefthook, commitlint, jscpd, knip).",
  "license": "MIT OR Apache-2.0",
  "author": "Denis Shirokov",
  "homepage": "https://github.com/tilr-dev/plugin-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilr-dev/plugin-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/tilr-dev/plugin-sdk/issues"
  },
  "keywords": [
    "tilr",
    "tilr-plugin",
    "plugin",
    "sdk",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tilr-plugin": "tools/tilr-plugin.mjs"
  },
  "exports": {
    ".": {
      "types": "./api/tilr.d.ts"
    },
    "./react": {
      "types": "./api/tilr/react.d.ts"
    },
    "./ui": {
      "types": "./api/tilr/ui.d.ts"
    },
    "./native": {
      "types": "./api/tilr/native.d.ts"
    },
    "./test": {
      "types": "./dist/test/harness.d.ts",
      "default": "./dist/test/harness.js"
    },
    "./test/node": {
      "types": "./tools/node-resolve.d.mts",
      "default": "./tools/node-resolve.mjs"
    },
    "./test/global-setup": {
      "types": "./tools/global-setup.d.mts",
      "default": "./tools/global-setup.mjs"
    },
    "./build": {
      "types": "./tools/build-plugin.d.mts",
      "default": "./tools/build-plugin.mjs"
    },
    "./playwright": {
      "types": "./tools/playwright.d.mts",
      "default": "./tools/playwright.mjs"
    },
    "./site/*": "./site/*",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.plugin.json": "./tsconfig.plugin.json",
    "./tsconfig.plugin-test.json": "./tsconfig.plugin-test.json",
    "./globals": {
      "types": "./globals.d.ts"
    },
    "./oxlint": "./presets/oxlint.json",
    "./install": {
      "types": "./tools/install-site.d.ts",
      "default": "./tools/install-site.js"
    },
    "./biome": "./presets/biome.json",
    "./lefthook.yml": "./presets/lefthook.yml",
    "./commitlint": "./presets/commitlint.js",
    "./jscpd.json": "./presets/jscpd.json",
    "./knip.json": "./presets/knip.json",
    "./package.json": "./package.json"
  },
  "files": [
    "api/",
    "dist/test/",
    "site/",
    "tools/",
    "!tools/*.test.mjs",
    "docs/",
    "globals.d.ts",
    "tsconfig.base.json",
    "tsconfig.plugin.json",
    "tsconfig.plugin-test.json",
    "presets/",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.harness.json",
    "check": "node tools/tilr-plugin.mjs verify --only lint,types",
    "format": "biome format --write .",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tools/*.test.mjs\" \"scripts/*.test.mjs\"",
    "verify": "node tools/tilr-plugin.mjs verify",
    "verify:full": "node tools/tilr-plugin.mjs verify --full",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "api:check": "node scripts/api-sync.mjs",
    "api:sync": "node scripts/api-sync.mjs --write",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run build && node scripts/sync-runtime.mjs --check",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "jscpd": "^5.4.1",
    "knip": "^6.42.1"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.0.0",
    "cordis": "^4.0.1",
    "esbuild": ">=0.25",
    "lefthook": "^2.2.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "lefthook": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "cordis": "npm:@deepseek-ai/cordis@4.0.1",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~7.0.2"
  }
}
