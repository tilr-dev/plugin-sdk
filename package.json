{
  "name": "@tilr-dev/plugin",
  "version": "0.1.14",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "description": "The kit for writing Tilr plugins in their own repos: the plugin API's types, the shared build and CLI (tilr-plugin, tilr), the e2e harness with the built core page, shared tsconfig, eslint and Playwright config.",
  "license": "MIT OR Apache-2.0",
  "author": "Denis Shirokov",
  "publishConfig": { "access": "public" },
  "bin": { "tilr": "tools/tilr.mjs", "tilr-plugin": "tools/tilr-plugin.mjs" },
  "exports": {
    ".": { "types": "./api/tilr.d.ts" },
    "./react": { "types": "./api/tilr/react.d.ts" },
    "./ui": { "types": "./api/tilr/ui.d.ts" },
    "./native": { "types": "./api/tilr/native.d.ts" },
    "./test": { "types": "./dist/test/harness.d.ts", "default": "./dist/test/harness.js" },
    "./test/node": { "types": "./tools/node-resolve.d.mts", "default": "./tools/node-resolve.mjs" },
    "./test/global-setup": { "types": "./tools/global-setup.d.mts", "default": "./tools/global-setup.mjs" },
    "./build": { "types": "./tools/build-plugin.d.mts", "default": "./tools/build-plugin.mjs" },
    "./playwright": { "types": "./tools/playwright.d.mts", "default": "./tools/playwright.mjs" },
    "./site/*": "./site/*",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.plugin.json": "./tsconfig.plugin.json",
    "./tsconfig.plugin-test.json": "./tsconfig.plugin-test.json",
    "./globals": { "types": "./globals.d.ts" },
    "./eslint": "./eslint.base.js",
    "./install": { "types": "./tools/install-site.d.ts", "default": "./tools/install-site.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "api/",
    "dist/test/",
    "site/",
    "tools/",
    "!tools/*.test.mjs",
    "docs/",
    "globals.d.ts",
    "tsconfig.base.json",
    "tsconfig.plugin.json",
    "tsconfig.plugin-test.json",
    "eslint.base.js",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.harness.json",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && eslint .",
    "test": "node --test 'tools/*.test.mjs'",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "api:check": "node scripts/api-sync.mjs",
    "api:sync": "node scripts/api-sync.mjs --write",
    "prepack": "npm run build && node scripts/sync-runtime.mjs --check",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@eslint/js": ">=10",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.0.0",
    "cordis": "^4.0.1",
    "esbuild": ">=0.25",
    "eslint": ">=10",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependenciesMeta": {
    "@eslint/js": { "optional": true },
    "@playwright/test": { "optional": true },
    "@types/react": { "optional": true },
    "esbuild": { "optional": true },
    "eslint": { "optional": true },
    "typescript-eslint": { "optional": true }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "cordis": "npm:@deepseek-ai/cordis@4.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
