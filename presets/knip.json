{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.{ts,tsx}",
    "src/api.ts",
    "build.mjs",
    "commitlint.config.js",
    "src/**/*.test.{ts,tsx}",
    "test/**/*.{ts,mjs}"
  ],
  "project": ["src/**/*.{ts,tsx,js,mjs}", "test/**/*.{ts,tsx,mjs}", "*.{js,mjs,ts}"],
  "ignoreExportsUsedInFile": true
}
