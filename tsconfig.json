{
  // The solution layout every plugin repo has too: this file only points at the projects, so
  // tsgolint (oxlint's type-aware rules) and the editor give each file the project it belongs to.
  // `tilr-plugin verify` type-checks the projects themselves (`tsc --noEmit -p`).
  // - tsconfig.src.json: the SDK's own declarations (tools/) and the API snapshot (api/)
  // - tsconfig.test.json: the e2e harness (test/), with Node's types
  "files": [],
  "references": [{ "path": "./tsconfig.src.json" }, { "path": "./tsconfig.test.json" }]
}
